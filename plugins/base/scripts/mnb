#!/usr/bin/env bash
# Create a branch, or switch to an existing local or origin branch.

if [[ $# -ne 1 ]]; then
    printf 'Usage: mnb <branch-name>\n' >&2
    exit 2
fi

if ! command -v git >/dev/null 2>&1; then
    printf 'mnb: git is not installed or is not on PATH\n' >&2
    exit 1
fi

branch="$1"
if ! git check-ref-format --branch "$branch" >/dev/null; then
    printf 'mnb: invalid branch name: %s\n' "$branch" >&2
    exit 2
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'mnb: not inside a Git work tree\n' >&2
    exit 1
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
    printf 'mnb: switching to local branch %s\n' "$branch"
    git checkout "$branch"
elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    printf 'mnb: creating local branch %s tracking origin/%s\n' "$branch" "$branch"
    git checkout --track -b "$branch" "origin/$branch"
else
    printf 'mnb: creating branch %s\n' "$branch"
    git checkout -b "$branch" && git push --set-upstream origin "$branch"
fi
